# Copy to .env.local for development. Never commit actual credentials.
# Production must use the final HTTPS origin (no path or trailing slash).
# Production placeholder: https://your-domain.example (replace with your actual domain).
# Local npm run dev normally uses port 3000; use 3001 here if running that preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project Settings > API. All three are needed for the admin workflow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only legacy service_role key; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Confirmed Supabase Auth account email(s), comma-separated; no demo admin bypass.
ADMIN_EMAIL=

# Required for real AI ingestion; optional for reading existing published content.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Generate at least 32 random characters; same value on app and selected scheduler.
# Also required by the database-backed abuse prevention / article views endpoint.
CRON_SECRET=
# Optional pipeline budget in milliseconds, clamped to 5000..240000 by the backend.
INGESTION_BUDGET_MS=240000

# Development only. Always false in production and previews; never seed production.
# Missing production database credentials must yield empty content, never fixtures.
DEMO_MODE=false
# Seed-script opt-in only, for an isolated development DB; keep false when deployed.
ALLOW_FICTIONAL_SEED=false
# Optional Search Console verification token, not an analytics ID.
GOOGLE_SITE_VERIFICATION=
# Optional public editorial contact address displayed on /contact.
CONTACT_EMAIL=

# GitHub scheduler settings are repository variables, NOT app environment variables:
# NEWS_SYNC_ENABLED=true; NEWS_SYNC_SCHEDULER=github;
# NEWS_SYNC_SITE_URL=https://your-production-domain
# Add CRON_SECRET as a GitHub Actions repository secret only when choosing GitHub.
